# Copy this file to .env and fill in your keys. .env is gitignored.

# --- Required ---
OPENAI_API_KEY=your_openai_key
PINECONE_API_KEY=your_pinecone_key
TAVILY_API_KEY=your_tavily_key

# --- Optional: MCP server cost controls ---
# Both have working defaults, so leave them unset unless you want to change the
# ceiling. SENTRYQUERY_MCP_RATE_LIMIT caps ask_corpus calls per client per
# rolling minute (default 10); cache hits are free and are not counted.
# SENTRYQUERY_MCP_CACHE_SIZE caps how many distinct questions the in-process
# answer cache holds before evicting the oldest (default 128).
# SENTRYQUERY_MCP_RATE_LIMIT=10
# SENTRYQUERY_MCP_CACHE_SIZE=128

# --- Optional: LangSmith tracing (Layer 3 observability) ---
# Leave these unset to run with tracing OFF — the app behaves identically and
# still emits structured per-run logs. Set all three to trace the two-agent
# graph in LangSmith (Researcher tool calls, drafted schema, Critic verdict,
# revision loop). LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY also work.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=sentryquery